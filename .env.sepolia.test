# Тестовый прогон x402 на Base Sepolia.
# Адрес взят из ~/.env (X402_TEST_PAYER_ADDRESS для плательщика,
# X402_PAY_TO для получателя). В старом бэкапе здесь стоял
# 0x2A13ed5b… — выдуманный адрес, который чуть не ушёл в тест.
RTA_MODE=x402
RTA_PRICE_ATOMS=1000000
RTA_PAY_TO=0xefCD6886f73064ea9EcbaA4741Ef1309A0885C59
RTA_HOST=127.0.0.1
RTA_PORT=8190
RTA_NETWORK=eip155:84532
RTA_RPC_URL=https://sepolia.base.org
RTA_FACILITATOR=https://x402.org/facilitator
