# RTA — конфигурация запуска. Скопируй в .env и заполни.
# Секретов здесь нет: платёжный адрес публичен по своей природе.

# free | x402. В free сервис не берёт денег и годится только для стенда.
RTA_MODE=x402

# Цена одного доказательства в атомах USDC (1 USDC = 1 000 000 атомов).
# Ниже себестоимости расчёта ×2 сервис откажется назначать — это в коде.
RTA_PRICE_ATOMS=2919

# Адрес получения на Base mainnet. Обязателен для x402: без него все
# платежи уйдут неизвестно куда, и подпись это уже не спасёт.
RTA_PAY_TO=0xЗАПОЛНИ_40_ЗНАКОВ

# Домен и порт для локального запуска. Наружу выставляется через туннель.
RTA_HOST=127.0.0.1
RTA_PORT=8080

# Узел сети для сверки транзакции. Без него расчёт считается
# состоявшимся по одному ответу фасилитатора — это недостаточно:
# ответ приходил с success: true, а транзакции в блокчейне не было.
RTA_RPC_URL=https://sepolia.base.org
