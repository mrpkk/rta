pragma circom 2.2.3;

// Доказывает: возраст >= 18, НЕ раскрывая ни возраст, ни дату рождения.
//
// Как это работает и почему это честно:
//   возраст раскладывается на 8 бит (значит 0..255);
//   разность (возраст - 18) тоже раскладывается на 8 бит;
//   из равенства sum(bits_diff) = возраст - 18 следует, что разность
//   неотрицательна — иначе в двоичной записи она не поместилась бы
//   в 8 неотрицательных бит.
// Тайна сохраняется: ни возраст, ни разность, ни биты не публикуются.

template AgeAtLeast18() {
    signal input age;
    signal input ageBits[8];
    signal input diffBits[8];

    var accAge = 0;
    var accDiff = 0;
    for (var i = 0; i < 8; i++) {
        ageBits[i] * (1 - ageBits[i]) === 0;      // каждый бит равен 0 или 1
        accAge  += ageBits[i] * (1 << i);
        diffBits[i] * (1 - diffBits[i]) === 0;
        accDiff += diffBits[i] * (1 << i);
    }
    accAge === age;                                // возраст = сумма его битов
    accAge - 18 === accDiff;                       // разность = сумма своих битов
}

component main = AgeAtLeast18();
